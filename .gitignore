# =============================================================================
# .gitignore Template für Software-Entwicklungsprojekte
# Kopieren und als .gitignore im Projektroot ablegen
# Projektspezifische Einträge am Ende anfügen
# =============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ---- Virtuelle Umgebungen ----
venv/
.venv/
env/
.env/

# ---- BACH Interne Steuerungsdateien (NIEMALS in Git!) ----
AUFGABEN.txt
AUFGABEN.txt.txt
TEST.txt
TESTS.txt
TESTERGEBNISSE.txt
BUGREPORT.md
BUGREPORT_*.md
DIAGNOSE_REPORT.md
ANALYSE_*.md

# ---- Persönliche / Sensible Daten ----
_USER/
.env
.env.*
credentials.json
client_secret*.json
token.json
secrets.*
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
keyring/

# ---- Build-Artefakte & Releases ----
releases/
*.exe
*.msi
*.msix
*.appx
*.spec
!ExplorerPro.spec

# ---- IDE & Editoren ----
.claude/
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Betriebssystem ----
desktop.ini
Thumbs.db
.DS_Store
ehthumbs.db

# ---- Standard-Patterns ----
PLAN.txt
_archive/
_private/
*.log
*.tmp
*.bak

# ---- Entwicklungs- und Backup-Ordner ----
_BACKUP/
_DEV/
_WARTUNG/
_alt/
_archiv/

# ---- Projektspezifisch ----
DIAGNOSE_REPORT.json
TESTBERICHT.txt

# Test-Dateien im Root (src/tests sind getrackt)
/test*.py
/test*.bat
DECISIONS.md
TODO.md
DONE.md
pytest_res.txt

# ---- Lokale Workflow- und temporäre Assets ----
LOCK
LOCK*.txt
LOCK.*
*.lock
uv.lock
!package-lock.json
_backups/
assets/_agy_instructions.txt
assets/android-icon-background.png
assets/android-icon-foreground.png
assets/android-icon-monochrome.png
assets/splash-icon.png

# ---- Multi-Host Sync-Konflikt-Muster (Cloud-Sync-Hygiene) ----
* (copy)*
* (Copy)*
* (kopie)*
* (Kopie)*
*conflicted copy*
*-WORKSTATION*
*-WORKSTATION-LG*
*-ASUS*
*-ASUS-GEI*
*-LAPTOP*
*-Mac Studio*
*-MacBook*
*-IDEAPAD*
*.sync-conflict-*
*.sync-temp-*
*.conflict
*-CONFLIT-*
*-conflict-*
*.orig
*.rej
.automation-lock

# ---- Test, Coverage & Build Caches ----
.coverage.*
.hypothesis/
.turbo/
wheelhouse/
.wheel-smoke/
.pytest_temp/
.pytest_tmp*/

# ---- Web / Node Caches ----
node_modules/
.nyc_output/

dist_clean/

# Agenten-interne Loop-Statusschnappschuesse (GITHUB-POLICY.md SS3, T-20260926-510472849)
TASKPLAN_STATUS_*.md
